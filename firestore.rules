rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation document
    match /test/{docId} {
      allow read: if true;
    }

    // Security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and account preferences
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Order records
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(orderId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid;
    }

    // Table & Dining booking records
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(bookingId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(bookingId) && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(bookingId) && resource.data.userId == request.auth.uid;
    }
  }
}

